# ====================================
# DATA MANAGEMENT - NEVER COMMIT DATA
# ====================================

# Data directories (git-ignored for size and privacy)
data/
# the workbench data layer is source code, not data: un-ignore it all
!apps/workbench/src/data/
!apps/workbench/src/data/**
datasets/
cache/
raw_data/
processed_data/
exports/
research_data/

# EXCEPTIONS: Allow small essential files for GitHub Pages deployment
!data/nz_places.geojson
!data/sa2.geojson
!ta_boundaries.geojson
!territorial_authorities.geojson
!sa2.geojson

# Allow region app data to be committed for GitHub Pages
!apps/regions/**/data/
!apps/regions/**/data/**
!apps/regions/**/data/*.geojson

# Geographic and spatial data files
*.geojson
*.kml
*.kmz
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.qpj

# App entry points and deployment data
!apps/**/*.html
!apps/regions/**/data/*.geojson

# Compressed geographic data
*.geojson.gz
*.kml.gz
*.json.gz
*.csv.gz

# Large data formats
*.parquet
*.feather
*.hdf5
*.h5
*.nc

# OpenStreetMap data
*.pbf
*.osm
*.osm.bz2
*.osm.gz
*.osm.xml

# Map tiles and raster data
*.mbtiles
*.tif
*.tiff
*.png.world
*.tfw

# Database exports and dumps
*.sql.dump
*.backup
*.bak

# Temporary processing files
*.tmp
*.temp
temp_*
cache_*
processing_*
download_*

# Research outputs (may be large)
figures/
plots/
analysis_output/
reports/output/
visualizations/

# Data processing artifacts
*.lock
!uv.lock
!Cargo.lock
*.pid
*.state
*.checkpoint

# Large CSV files (keep small samples, ignore large datasets)
*_large.csv
*_full.csv
*_complete.csv
data_*.csv

# Lightweight documentation templates
!docs/templates/
!docs/templates/**
!docs/examples/revisions/*.csv

# Jupyter notebook outputs (keep notebooks, ignore large outputs)
*.ipynb_checkpoints/

# Test data (keep small test files, ignore large test datasets)
test_data_large/
test_datasets/

# Backup files
*.backup
*~backup
*.orig

# Version control for data (use proper data versioning tools)
*.v1
*.v2
*.version_*

# the global gitignore excludes *.csv; source extracts in archive are project records
!archive/statsnz-2023-census-totals-sa2/*.csv

# guide-capture run artifacts: screenshots live on R2, reports are ephemeral
tools/guide-captures/*/
tools/guide-captures/_run-report.json
