{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-bayes.github.io/places-of-worship/schemas/change-event.schema.json",
  "title": "Place of Worship — Change Event",
  "description": "Append-only event envelope for accepted or staged changes to places of worship. Events are bitemporal: effective dates describe the world, recorded_at describes when the project logged the event. Replay rule (DECISIONS.md D3): the snapshot for date S as publishable at audit time T replays accepted events with effective time <= S and recorded_at <= T; bounded effective times order by their latest admissible date (not_later_than <= S replays into S; bounds straddling S contribute uncertainty, not state); current products use T = now, and published artefacts pin T in their run manifests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "client_event_id",
    "event_type",
    "event_intent",
    "target",
    "effective",
    "recorded_at",
    "source_refs",
    "review",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^change-event\\.v[0-9]+$"
    },
    "event_id": { "$ref": "#/$defs/Uuid" },
    "client_event_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable submitter-side idempotency key. Replays must not apply the same client_event_id twice for the same source batch."
    },
    "event_type": {
      "type": "string",
      "description": "Event type drives both the payload shape and the allowed event_intent values via the top-level allOf.",
      "enum": [
        "site_created",
        "site_location_corrected",
        "site_relocated",
        "site_closed",
        "site_reopened",
        "site_status_corrected",
        "site_status_changed",
        "denomination_corrected",
        "denomination_changed",
        "denomination_added",
        "denomination_removed",
        "purpose_added",
        "purpose_removed",
        "worship_function_observed",
        "worship_use_appeared",
        "worship_use_disappeared",
        "worship_use_split",
        "worship_use_merged",
        "organisation_use_started",
        "organisation_use_ended",
        "site_name_corrected",
        "site_name_changed",
        "site_attributes_corrected",
        "site_attributes_changed",
        "site_attributes_observed",
        "site_lifecycle_claimed",
        "duplicate_merged",
        "duplicate_split",
        "structure_created",
        "structure_geometry_corrected",
        "structure_demolished",
        "proposal_retracted",
        "proposal_superseded"
      ]
    },
    "event_intent": {
      "type": "string",
      "description": "Correction means the previous project record was wrong. Evidence_observation means a staged source row records evidence that needs review. Observed_change means the world changed. Lifecycle covers creation, closure, reopening, demolition, and relocation events with bounded effective dates. Review_state covers proposal lifecycle changes. Per-event_type constraints are enforced under the top-level allOf.",
      "enum": ["correction", "evidence_observation", "observed_change", "lifecycle", "review_state"]
    },
    "target": { "$ref": "#/$defs/EventTarget" },
    "effective": { "$ref": "#/$defs/EffectiveTime" },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC system time when the project logged the event. Never backdated: corrections to world history change effective, not recorded_at."
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/SourceRef" }
    },
    "review": { "$ref": "#/$defs/ReviewRef" },
    "taxonomy_version": {
      "type": ["string", "null"],
      "description": "Authoritative taxonomy version for the whole event, resolving against schemas/denomination-taxonomy.json. Required for denomination_* events and for any payload carrying denomination codes. Do not duplicate inside payloads."
    },
    "supersedes_event_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/Uuid" }
    },
    "payload_hash": {
      "type": ["string", "null"],
      "description": "Hash of the normalised payload used for replay and audit checks. May be null while staged; required once review.review_status is accepted."
    },
    "payload": {
      "oneOf": [
        { "$ref": "#/$defs/SiteCreatedPayload" },
        { "$ref": "#/$defs/StructureCreatedPayload" },
        { "$ref": "#/$defs/GeometryPayload" },
        { "$ref": "#/$defs/RelocationPayload" },
        { "$ref": "#/$defs/DenominationPayload" },
        { "$ref": "#/$defs/WorshipFunctionPayload" },
        { "$ref": "#/$defs/OrganisationLinkPayload" },
        { "$ref": "#/$defs/StatusPayload" },
        { "$ref": "#/$defs/NamePayload" },
        { "$ref": "#/$defs/AttributeUpdatePayload" },
        { "$ref": "#/$defs/LifecycleClaimPayload" },
        { "$ref": "#/$defs/DuplicatePayload" },
        { "$ref": "#/$defs/ProposalPayload" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "const": "site_created" } } },
      "then": { "properties": { "payload": { "required": ["payload_type"], "properties": { "payload_type": { "const": "site_created" } } } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "const": "structure_created" } } },
      "then": { "properties": { "payload": { "required": ["payload_type"], "properties": { "payload_type": { "const": "structure_created" } } } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "enum": ["site_location_corrected", "structure_geometry_corrected"] } } },
      "then": { "properties": { "payload": { "required": ["payload_type"], "properties": { "payload_type": { "const": "geometry_update" } } } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "const": "site_relocated" } } },
      "then": { "properties": { "payload": { "required": ["payload_type"], "properties": { "payload_type": { "const": "site_relocation" } } } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "enum": ["site_closed", "site_reopened", "site_status_corrected", "site_status_changed", "structure_demolished"] } } },
      "then": { "properties": { "payload": { "required": ["payload_type"], "properties": { "payload_type": { "const": "status_update" } } } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "enum": ["denomination_corrected", "denomination_changed"] } } },
      "then": { "properties": { "payload": { "required": ["payload_type"], "properties": { "payload_type": { "const": "denomination_update" } } } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "enum": ["denomination_added", "denomination_removed", "purpose_added", "purpose_removed", "worship_function_observed", "worship_use_appeared", "worship_use_disappeared", "worship_use_split", "worship_use_merged"] } } },
      "then": { "properties": { "payload": { "required": ["payload_type"], "properties": { "payload_type": { "const": "worship_function_update" } } } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "enum": ["organisation_use_started", "organisation_use_ended"] } } },
      "then": { "properties": { "payload": { "required": ["payload_type"], "properties": { "payload_type": { "const": "organisation_link_update" } } } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "enum": ["site_name_corrected", "site_name_changed"] } } },
      "then": { "properties": { "payload": { "required": ["payload_type"], "properties": { "payload_type": { "const": "name_update" } } } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "enum": ["site_attributes_corrected", "site_attributes_changed", "site_attributes_observed"] } } },
      "then": { "properties": { "payload": { "required": ["payload_type"], "properties": { "payload_type": { "const": "attribute_update" } } } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "const": "site_lifecycle_claimed" } } },
      "then": { "properties": { "payload": { "required": ["payload_type"], "properties": { "payload_type": { "const": "lifecycle_claim" } } } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "enum": ["duplicate_merged", "duplicate_split"] } } },
      "then": { "properties": { "payload": { "required": ["payload_type"], "properties": { "payload_type": { "const": "duplicate_resolution" } } } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "enum": ["proposal_retracted", "proposal_superseded"] } } },
      "then": { "properties": { "payload": { "required": ["payload_type"], "properties": { "payload_type": { "const": "proposal_state" } } } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "enum": ["site_location_corrected", "structure_geometry_corrected", "site_status_corrected", "denomination_corrected", "site_name_corrected", "site_attributes_corrected", "duplicate_merged", "duplicate_split"] } } },
      "then": { "properties": { "event_intent": { "const": "correction" } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "enum": ["site_status_changed", "denomination_changed", "denomination_added", "denomination_removed", "purpose_added", "purpose_removed", "site_name_changed", "site_attributes_changed"] } } },
      "then": { "properties": { "event_intent": { "const": "observed_change" } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "enum": ["worship_function_observed", "site_attributes_observed", "site_lifecycle_claimed"] } } },
      "then": { "properties": { "event_intent": { "const": "evidence_observation" } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "const": "site_relocated" } } },
      "then": { "properties": { "event_intent": { "enum": ["observed_change", "lifecycle"] } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "enum": ["organisation_use_started", "organisation_use_ended"] } } },
      "then": { "properties": { "event_intent": { "enum": ["observed_change", "lifecycle"] } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "enum": ["site_created", "structure_created", "site_closed", "site_reopened", "structure_demolished", "worship_use_appeared", "worship_use_disappeared", "worship_use_split", "worship_use_merged"] } } },
      "then": { "properties": { "event_intent": { "const": "lifecycle" } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "enum": ["proposal_retracted", "proposal_superseded"] } } },
      "then": { "properties": { "event_intent": { "const": "review_state" } } }
    },
    {
      "if": { "required": ["review"], "properties": { "review": { "required": ["review_status"], "properties": { "review_status": { "const": "accepted" } } } } },
      "then": { "required": ["payload_hash"], "properties": { "payload_hash": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "required": ["event_type"], "properties": { "event_type": { "pattern": "^denomination_" } } },
      "then": { "required": ["taxonomy_version"], "properties": { "taxonomy_version": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "anyOf": [
              { "required": ["denomination_set"] },
              { "required": ["previous_denomination_set"] },
              { "required": ["denomination_code"] },
              { "required": ["previous_denomination_code"] }
            ]
          }
        }
      },
      "then": { "required": ["taxonomy_version"], "properties": { "taxonomy_version": { "type": "string", "minLength": 1 } } }
    }
  ],
  "$defs": {
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "DatasetId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "PartialDate": {
      "type": "string",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "description": "Gregorian date with year, month, or day precision. Country-specific lifecycle floors are validation context, not schema constants."
    },
    "BoundedDate": {
      "type": "object",
      "additionalProperties": false,
      "description": "Source-backed date where the source may state an exact value, a lower bound, an upper bound, or no date. Unknown date components remain absent rather than placeholders.",
      "properties": {
        "value": { "$ref": "#/$defs/PartialDate" },
        "not_earlier_than": { "$ref": "#/$defs/PartialDate" },
        "not_later_than": { "$ref": "#/$defs/PartialDate" }
      }
    },
    "ArchiveRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_name", "collection", "consulted_date"],
      "properties": {
        "repository_name": { "type": "string", "minLength": 1 },
        "collection": { "type": "string", "minLength": 1 },
        "item_ref": { "type": ["string", "null"] },
        "consulted_date": { "$ref": "#/$defs/PartialDate" },
        "location": { "type": ["string", "null"] }
      }
    },
    "SourceType": {
      "type": "string",
      "enum": [
        "osm_history",
        "osm_date_tags",
        "street_imagery",
        "aerial_imagery",
        "field_observation",
        "charities_register",
        "incorporated_societies",
        "linz_building_outlines",
        "linz_property",
        "denominational_directory",
        "archived_website",
        "local_council",
        "heritage_list",
        "census_or_statistics",
        "church_record",
        "denominational_yearbook",
        "newspaper_archive",
        "charity_or_society_register",
        "map_or_survey",
        "academic_work",
        "oral_history",
        "other"
      ]
    },
    "SourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "anyOf": [
        { "required": ["url"] },
        { "required": ["archive_ref"] }
      ],
      "properties": {
        "source_type": { "$ref": "#/$defs/SourceType" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "minLength": 1 },
        "archive_ref": { "$ref": "#/$defs/ArchiveRef" },
        "provider": { "type": ["string", "null"] },
        "source_date": { "$ref": "#/$defs/PartialDate" },
        "consulted_date": { "$ref": "#/$defs/PartialDate" },
        "licence": { "type": ["string", "null"] },
        "access_limits": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "Confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "EventTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_type"],
      "properties": {
        "target_type": {
          "type": "string",
          "enum": ["site", "structure", "organisation", "proposal", "batch"]
        },
        "site_id": { "$ref": "#/$defs/Uuid" },
        "matched_current_site_id": {
          "type": "string",
          "description": "Temporary reference to the current map/master candidate id while accepted site UUIDs are not yet available."
        },
        "candidate_site_id": {
          "type": "string",
          "description": "Temporary candidate-site reference from RA evidence templates."
        },
        "structure_id": { "$ref": "#/$defs/Uuid" },
        "org_id": { "$ref": "#/$defs/Uuid" },
        "proposal_id": { "$ref": "#/$defs/Uuid" },
        "submission_batch_id": { "$ref": "#/$defs/Uuid" }
      }
    },
    "EffectiveTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_precision", "basis"],
      "anyOf": [
        { "required": ["effective_date"] },
        { "required": ["not_earlier_than"] },
        { "required": ["not_later_than"] }
      ],
      "properties": {
        "effective_date": {
          "type": "string",
          "format": "date"
        },
        "not_earlier_than": {
          "type": "string",
          "format": "date"
        },
        "not_later_than": {
          "type": "string",
          "format": "date"
        },
        "date_precision": {
          "type": "string",
          "enum": ["day", "month", "year", "bounded", "unknown"]
        },
        "basis": {
          "type": "string",
          "enum": ["source_statement", "source_observation", "reviewer_inference", "system_recorded"]
        },
        "note": {
          "type": ["string", "null"]
        }
      }
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref_type"],
      "properties": {
        "source_ref_type": {
          "type": "string",
          "enum": ["source_dataset", "source_record", "evidence_row", "site_observation", "contributor_attestation", "review_note"]
        },
        "source_dataset_id": { "$ref": "#/$defs/DatasetId" },
        "source_record_id": { "type": ["string", "null"] },
        "evidence_row_id": { "type": ["string", "null"] },
        "site_observation_id": { "type": ["string", "null"] },
        "stage_batch_id": { "type": ["string", "null"] },
        "stage_record_index": { "type": ["integer", "null"], "minimum": 1 },
        "stage_input_sha256": { "type": ["string", "null"] },
        "url_or_file": { "type": ["string", "null"] },
        "licence_status": {
          "type": ["string", "null"],
          "enum": ["accepted", "needs_review", "restricted", "unknown", null]
        },
        "evidence_summary": { "type": ["string", "null"] }
      }
    },
    "ReviewRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_status"],
      "properties": {
        "staged_proposal_id": { "$ref": "#/$defs/Uuid" },
        "review_decision_id": { "$ref": "#/$defs/Uuid" },
        "contributor_id": { "$ref": "#/$defs/Uuid" },
        "reviewer_id": { "$ref": "#/$defs/Uuid" },
        "reviewed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "review_status": {
          "type": "string",
          "enum": ["staged", "accepted", "rejected", "superseded", "retracted", "adjudication_required"]
        },
        "display_clearance": {
          "type": ["string", "null"],
          "description": "Reviewer decision about whether culturally sensitive site-level detail may reach public map products. Sensitive payloads require cleared_for_public_display before public export.",
          "enum": ["not_assessed", "cleared_for_public_display", "restricted_from_public_display", null]
        },
        "display_clearance_basis": { "type": ["string", "null"] },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "rationale": { "type": ["string", "null"] }
      }
    },
    "SiteCreatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_type", "site_id", "country_code", "geometry", "status"],
      "allOf": [
        {
          "if": { "required": ["culturally_sensitive"], "properties": { "culturally_sensitive": { "const": true } } },
          "then": { "required": ["sensitivity_basis"], "properties": { "sensitivity_basis": { "type": "string", "minLength": 1 } } }
        }
      ],
      "properties": {
        "payload_type": { "type": "string", "const": "site_created" },
        "site_id": { "$ref": "#/$defs/Uuid" },
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "geometry": { "$ref": "site.schema.json#/$defs/Geometry" },
        "status": { "$ref": "site.schema.json#/$defs/Status" },
        "name": { "type": ["string", "null"] },
        "culturally_sensitive": { "type": "boolean", "default": false },
        "sensitivity_basis": {
          "type": ["string", "null"],
          "description": "Free-text basis for a culturally sensitive site-level claim, such as kastom, urupā, or another restricted-display concern."
        }
      }
    },
    "StructureCreatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_type", "structure_id", "site_id", "status"],
      "properties": {
        "payload_type": { "type": "string", "const": "structure_created" },
        "structure_id": { "$ref": "#/$defs/Uuid" },
        "site_id": { "$ref": "#/$defs/Uuid" },
        "geometry": { "$ref": "site.schema.json#/$defs/Geometry" },
        "building_type": {
          "type": ["string", "null"],
          "description": "OSM building=* value if known (e.g., church, mosque, synagogue, temple, chapel, cathedral, monastery, shrine, pagoda, gurdwara, religious)."
        },
        "status": { "$ref": "structure.schema.json#/$defs/Status" }
      }
    },
    "GeometryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_type", "geometry", "geometry_role", "geometry_basis"],
      "allOf": [
        {
          "if": { "required": ["culturally_sensitive"], "properties": { "culturally_sensitive": { "const": true } } },
          "then": { "required": ["sensitivity_basis"], "properties": { "sensitivity_basis": { "type": "string", "minLength": 1 } } }
        }
      ],
      "properties": {
        "payload_type": { "type": "string", "const": "geometry_update" },
        "geometry_history_id": { "$ref": "#/$defs/Uuid" },
        "previous_geometry_history_id": { "$ref": "#/$defs/Uuid" },
        "geometry": { "$ref": "site.schema.json#/$defs/Geometry" },
        "geometry_role": {
          "type": "string",
          "enum": ["site_location", "structure_outline", "parcel_or_compound", "approximate_point", "historical_locality", "inferred_region"]
        },
        "geometry_basis": {
          "type": "string",
          "enum": ["osm_object", "building_outline", "geocoded_address", "street_imagery", "aerial_imagery", "historical_map", "directory_address", "reviewer_point", "inferred_locality", "corrected_coordinate", "other"]
        },
        "distance_from_previous_m": { "type": ["number", "null"], "minimum": 0 },
        "uncertainty_radius_m": { "type": ["integer", "null"], "minimum": 0 },
        "culturally_sensitive": { "type": "boolean", "default": false },
        "sensitivity_basis": { "type": ["string", "null"] }
      }
    },
    "RelocationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_type", "from_site_id", "to_site_id", "relation_type"],
      "allOf": [
        {
          "if": { "required": ["culturally_sensitive"], "properties": { "culturally_sensitive": { "const": true } } },
          "then": { "required": ["sensitivity_basis"], "properties": { "sensitivity_basis": { "type": "string", "minLength": 1 } } }
        }
      ],
      "properties": {
        "payload_type": { "type": "string", "const": "site_relocation" },
        "from_site_id": { "$ref": "#/$defs/Uuid" },
        "to_site_id": { "$ref": "#/$defs/Uuid" },
        "org_id": { "$ref": "#/$defs/Uuid" },
        "relation_type": {
          "type": "string",
          "enum": ["successor_of", "relocated_from", "relocated_to"]
        },
        "previous_geometry_history_id": { "$ref": "#/$defs/Uuid" },
        "new_geometry_history_id": { "$ref": "#/$defs/Uuid" },
        "distance_m": { "type": ["number", "null"], "minimum": 0 },
        "identity_note": { "type": ["string", "null"] },
        "culturally_sensitive": { "type": "boolean", "default": false },
        "sensitivity_basis": { "type": ["string", "null"] }
      }
    },
    "DenominationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_type", "denomination_code"],
      "allOf": [
        {
          "if": { "required": ["culturally_sensitive"], "properties": { "culturally_sensitive": { "const": true } } },
          "then": { "required": ["sensitivity_basis"], "properties": { "sensitivity_basis": { "type": "string", "minLength": 1 } } }
        }
      ],
      "properties": {
        "payload_type": { "type": "string", "const": "denomination_update" },
        "denomination_code": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "denomination_raw": { "type": ["string", "null"] },
        "religion_code": { "type": ["string", "null"] },
        "previous_denomination_code": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9._-]*$" },
        "culturally_sensitive": { "type": "boolean", "default": false },
        "sensitivity_basis": { "type": ["string", "null"] }
      }
    },
    "WorshipUseStatus": {
      "type": "string",
      "enum": [
        "confirmed_worship",
        "probable_worship",
        "organisation_only",
        "building_only",
        "not_worship",
        "uncertain"
      ]
    },
    "TargetYearStatus": {
      "type": "string",
      "enum": ["present", "absent", "uncertain", "not_assessed"]
    },
    "SiteType": {
      "type": "string",
      "enum": [
        "place_of_worship",
        "chapel",
        "church",
        "mosque",
        "temple",
        "synagogue",
        "marae_church",
        "multi_use",
        "other",
        "unknown"
      ]
    },
    "PurposeCode": {
      "type": "string",
      "enum": [
        "worship",
        "community",
        "education",
        "social_services",
        "office",
        "heritage",
        "residential",
        "commercial",
        "other",
        "unknown"
      ]
    },
    "DenominationCodeSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" }
    },
    "PurposeCodeSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/PurposeCode" }
    },
    "OrganisationRole": {
      "type": "string",
      "enum": ["primary", "host", "tenant", "shared"]
    },
    "OrganisationLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["org_id", "role"],
      "properties": {
        "org_id": { "$ref": "#/$defs/Uuid" },
        "role": { "$ref": "#/$defs/OrganisationRole" },
        "link_confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "note": { "type": ["string", "null"] }
      }
    },
    "TargetYearAffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_year", "target_year_status"],
      "properties": {
        "target_year": {
          "type": "string",
          "format": "date",
          "description": "Snapshot date affected by the event, for example 2018-09-01."
        },
        "previous_target_year_status": {
          "anyOf": [
            { "$ref": "#/$defs/TargetYearStatus" },
            { "type": "null" }
          ]
        },
        "target_year_status": { "$ref": "#/$defs/TargetYearStatus" },
        "worship_use_status": {
          "anyOf": [
            { "$ref": "#/$defs/WorshipUseStatus" },
            { "type": "null" }
          ]
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "basis": {
          "type": ["string", "null"],
          "enum": ["source_statement", "source_observation", "reviewer_inference", "system_recorded", null]
        },
        "note": { "type": ["string", "null"] }
      }
    },
    "GeocodingBasis": {
      "type": "string",
      "enum": [
        "exact_address",
        "historical_address_matched",
        "described_locality",
        "map_georeference",
        "regional_only",
        "unknown"
      ]
    },
    "ContainingArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area_name"],
      "properties": {
        "area_id": { "type": ["string", "null"] },
        "area_name": { "type": "string", "minLength": 1 },
        "area_type": {
          "type": ["string", "null"],
          "enum": ["country", "adm1", "adm2", "locality", "island", "customary_area", "other", null]
        },
        "country_code": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" }
      }
    },
    "LocationClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geocoding_basis"],
      "anyOf": [
        { "required": ["geometry"] },
        { "required": ["containing_area"] },
        { "required": ["historical_address"] },
        { "required": ["described_locality"] }
      ],
      "properties": {
        "geometry": { "$ref": "site.schema.json#/$defs/Geometry" },
        "historical_address": { "type": ["string", "null"] },
        "modern_address_candidate": { "type": ["string", "null"] },
        "described_locality": { "type": ["string", "null"] },
        "containing_area": { "$ref": "#/$defs/ContainingArea" },
        "geocoding_basis": { "$ref": "#/$defs/GeocodingBasis" },
        "geocoding_confidence": { "$ref": "#/$defs/Confidence" },
        "location_note": { "type": ["string", "null"] }
      }
    },
    "NameHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "from": { "$ref": "#/$defs/BoundedDate" },
        "to": { "$ref": "#/$defs/BoundedDate" },
        "name_type": {
          "type": ["string", "null"],
          "enum": ["official", "local", "alt", "historic", null]
        },
        "name_lang": { "type": ["string", "null"], "description": "BCP-47 language tag, if known." },
        "name_script": { "type": ["string", "null"], "description": "ISO 15924 script code, if known." },
        "source_references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SourceReference" }
        },
        "note": { "type": ["string", "null"] }
      }
    },
    "LifecycleEventKind": {
      "type": "string",
      "enum": ["founding", "opening", "first_seen", "last_seen", "closure", "demolition", "change_of_use", "rebuild"]
    },
    "WorshipFunctionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_type"],
      "allOf": [
        {
          "if": { "required": ["culturally_sensitive"], "properties": { "culturally_sensitive": { "const": true } } },
          "then": { "required": ["sensitivity_basis"], "properties": { "sensitivity_basis": { "type": "string", "minLength": 1 } } }
        }
      ],
      "anyOf": [
        { "required": ["worship_use_status"] },
        { "required": ["denomination_set"] },
        { "required": ["purpose_set"] },
        { "required": ["site_type"] },
        { "required": ["organisation_links"] },
        { "required": ["target_year_affects"] },
        { "required": ["split_from_site_ids"] },
        { "required": ["split_to_site_ids"] },
        { "required": ["merged_from_site_ids"] }
      ],
      "properties": {
        "payload_type": { "type": "string", "const": "worship_function_update" },
        "worship_use_status": { "$ref": "#/$defs/WorshipUseStatus" },
        "previous_worship_use_status": {
          "anyOf": [
            { "$ref": "#/$defs/WorshipUseStatus" },
            { "type": "null" }
          ]
        },
        "denomination_set": { "$ref": "#/$defs/DenominationCodeSet" },
        "previous_denomination_set": {
          "anyOf": [
            { "$ref": "#/$defs/DenominationCodeSet" },
            { "type": "null" }
          ]
        },
        "purpose_set": { "$ref": "#/$defs/PurposeCodeSet" },
        "previous_purpose_set": {
          "anyOf": [
            { "$ref": "#/$defs/PurposeCodeSet" },
            { "type": "null" }
          ]
        },
        "site_type": { "$ref": "#/$defs/SiteType" },
        "previous_site_type": {
          "anyOf": [
            { "$ref": "#/$defs/SiteType" },
            { "type": "null" }
          ]
        },
        "organisation_links": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/OrganisationLink" }
        },
        "target_year_affects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/TargetYearAffect" }
        },
        "split_from_site_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Uuid" }
        },
        "split_to_site_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Uuid" }
        },
        "merged_from_site_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Uuid" }
        },
        "merged_to_site_id": { "$ref": "#/$defs/Uuid" },
        "function_note": { "type": ["string", "null"] },
        "culturally_sensitive": { "type": "boolean", "default": false },
        "sensitivity_basis": { "type": ["string", "null"] }
      }
    },
    "OrganisationLinkPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_type", "site_id", "org_id", "role"],
      "allOf": [
        {
          "if": { "required": ["culturally_sensitive"], "properties": { "culturally_sensitive": { "const": true } } },
          "then": { "required": ["sensitivity_basis"], "properties": { "sensitivity_basis": { "type": "string", "minLength": 1 } } }
        }
      ],
      "properties": {
        "payload_type": { "type": "string", "const": "organisation_link_update" },
        "site_id": { "$ref": "#/$defs/Uuid" },
        "org_id": { "$ref": "#/$defs/Uuid" },
        "role": { "$ref": "#/$defs/OrganisationRole" },
        "previous_role": {
          "anyOf": [
            { "$ref": "#/$defs/OrganisationRole" },
            { "type": "null" }
          ]
        },
        "started_at": {
          "type": ["string", "null"],
          "format": "date"
        },
        "ended_at": {
          "type": ["string", "null"],
          "format": "date"
        },
        "target_year_affects": {
          "type": "array",
          "items": { "$ref": "#/$defs/TargetYearAffect" }
        },
        "link_note": { "type": ["string", "null"] },
        "culturally_sensitive": { "type": "boolean", "default": false },
        "sensitivity_basis": { "type": ["string", "null"] }
      }
    },
    "StatusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_type", "new_status"],
      "allOf": [
        {
          "if": { "required": ["culturally_sensitive"], "properties": { "culturally_sensitive": { "const": true } } },
          "then": { "required": ["sensitivity_basis"], "properties": { "sensitivity_basis": { "type": "string", "minLength": 1 } } }
        }
      ],
      "properties": {
        "payload_type": { "type": "string", "const": "status_update" },
        "previous_status": {
          "anyOf": [
            { "$ref": "site.schema.json#/$defs/Status" },
            { "type": "null" }
          ]
        },
        "new_status": { "$ref": "site.schema.json#/$defs/Status" },
        "status_note": { "type": ["string", "null"] },
        "culturally_sensitive": { "type": "boolean", "default": false },
        "sensitivity_basis": { "type": ["string", "null"] }
      }
    },
    "NamePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_type", "new_name"],
      "allOf": [
        {
          "if": { "required": ["culturally_sensitive"], "properties": { "culturally_sensitive": { "const": true } } },
          "then": { "required": ["sensitivity_basis"], "properties": { "sensitivity_basis": { "type": "string", "minLength": 1 } } }
        }
      ],
      "properties": {
        "payload_type": { "type": "string", "const": "name_update" },
        "new_name": { "type": "string" },
        "previous_name": { "type": ["string", "null"] },
        "name_type": {
          "type": ["string", "null"],
          "enum": ["official", "local", "alt", "historic", null]
        },
        "name_lang": { "type": ["string", "null"], "description": "BCP-47 language tag, if known." },
        "name_script": { "type": ["string", "null"], "description": "ISO 15924 script code, if known." },
        "name_date": { "$ref": "#/$defs/BoundedDate" },
        "source_references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SourceReference" }
        },
        "culturally_sensitive": { "type": "boolean", "default": false },
        "sensitivity_basis": { "type": ["string", "null"] }
      }
    },
    "AttributeUpdatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_type", "source_references"],
      "allOf": [
        {
          "if": { "required": ["culturally_sensitive"], "properties": { "culturally_sensitive": { "const": true } } },
          "then": { "required": ["sensitivity_basis"], "properties": { "sensitivity_basis": { "type": "string", "minLength": 1 } } }
        }
      ],
      "anyOf": [
        { "required": ["building_material"] },
        { "required": ["capacity"] },
        { "required": ["architecture_notes"] },
        { "required": ["name_history_entries"] }
      ],
      "properties": {
        "payload_type": { "type": "string", "const": "attribute_update" },
        "building_material": { "type": ["string", "null"] },
        "previous_building_material": { "type": ["string", "null"] },
        "capacity": { "type": ["integer", "null"], "minimum": 0 },
        "previous_capacity": { "type": ["integer", "null"], "minimum": 0 },
        "architecture_notes": { "type": ["string", "null"] },
        "previous_architecture_notes": { "type": ["string", "null"] },
        "name_history_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/NameHistoryEntry" }
        },
        "source_references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SourceReference" }
        },
        "attribute_note": { "type": ["string", "null"] },
        "culturally_sensitive": { "type": "boolean", "default": false },
        "sensitivity_basis": { "type": ["string", "null"] }
      }
    },
    "LifecycleClaimPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_type", "event_kind", "date", "confidence", "source_references"],
      "allOf": [
        {
          "if": { "required": ["culturally_sensitive"], "properties": { "culturally_sensitive": { "const": true } } },
          "then": { "required": ["sensitivity_basis"], "properties": { "sensitivity_basis": { "type": "string", "minLength": 1 } } }
        }
      ],
      "properties": {
        "payload_type": { "type": "string", "const": "lifecycle_claim" },
        "event_kind": { "$ref": "#/$defs/LifecycleEventKind" },
        "date": { "$ref": "#/$defs/BoundedDate" },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "source_references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SourceReference" }
        },
        "location_claim": { "$ref": "#/$defs/LocationClaim" },
        "target_year_affects": {
          "type": "array",
          "items": { "$ref": "#/$defs/TargetYearAffect" }
        },
        "claim_note": { "type": ["string", "null"] },
        "culturally_sensitive": { "type": "boolean", "default": false },
        "sensitivity_basis": { "type": ["string", "null"] }
      }
    },
    "DuplicatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_type", "survivor_site_id", "duplicate_site_ids"],
      "properties": {
        "payload_type": { "type": "string", "const": "duplicate_resolution" },
        "survivor_site_id": { "$ref": "#/$defs/Uuid" },
        "duplicate_site_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Uuid" }
        },
        "resolution_note": { "type": ["string", "null"] }
      }
    },
    "ProposalPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_type", "proposal_id", "reason"],
      "properties": {
        "payload_type": { "type": "string", "const": "proposal_state" },
        "proposal_id": { "$ref": "#/$defs/Uuid" },
        "reason": { "type": "string" },
        "superseded_by_proposal_id": { "$ref": "#/$defs/Uuid" }
      }
    }
  }
}
