{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-bayes.github.io/places-of-worship/schemas/geometry-history.schema.json",
  "title": "Place of Worship — Geometry History",
  "description": "Time-bounded geometry state for a site or structure. This schema records where the project believes a mappable worship place was located during a valid interval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "geometry_history_id",
    "site_id",
    "geometry",
    "geometry_role",
    "geometry_basis",
    "valid_interval",
    "identity_rule_applied",
    "confidence",
    "source_refs",
    "derived_from_event_id"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^geometry-history\\.v[0-9]+$"
    },
    "geometry_history_id": { "$ref": "#/$defs/Uuid" },
    "site_id": { "$ref": "#/$defs/Uuid" },
    "structure_id": { "$ref": "#/$defs/Uuid" },
    "org_id": {
      "$ref": "#/$defs/Uuid",
      "description": "Optional organisation context when a geometry state is linked to congregation movement."
    },
    "country_code": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]{2}$"
    },
    "geometry": { "$ref": "site.schema.json#/$defs/Geometry" },
    "centroid": { "$ref": "site.schema.json#/$defs/PointGeometry" },
    "geometry_role": {
      "type": "string",
      "enum": ["site_location", "structure_outline", "parcel_or_compound", "approximate_point", "historical_locality", "inferred_region"]
    },
    "geometry_basis": {
      "type": "string",
      "enum": ["osm_object", "building_outline", "geocoded_address", "street_imagery", "aerial_imagery", "historical_map", "directory_address", "reviewer_point", "inferred_locality", "corrected_coordinate", "other"]
    },
    "valid_interval": { "$ref": "#/$defs/ValidInterval" },
    "identity_rule_applied": {
      "type": "string",
      "description": "Records whether the evidence was treated as a same-site geometry update or as a new-site relocation link.",
      "enum": [
        "initial_site_geometry",
        "same_site_geometry_update",
        "new_site_successor_created",
        "structure_change_same_site",
        "organisation_relocation_link",
        "uncertain_requires_review"
      ]
    },
    "predecessor_site_id": { "$ref": "#/$defs/Uuid" },
    "successor_site_id": { "$ref": "#/$defs/Uuid" },
    "change_reason": {
      "type": "string",
      "enum": [
        "initial_observation",
        "corrected_geometry",
        "relocated_site_created",
        "address_renumbered",
        "building_rebuilt_same_site",
        "structure_demolished",
        "fuzzy_historical_placement",
        "source_update",
        "other"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uncertainty_radius_m": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Radius in whole metres within which the place is believed to lie; the numeric companion of location_confidence, which is derived from it (portal ruling 2026-09-02)."
    },
    "location_confidence": {
      "type": ["string", "null"],
      "enum": ["exact", "building", "parcel_or_compound", "street", "locality", "area", "unknown", null]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/SourceRef" }
    },
    "derived_from_event_id": { "$ref": "#/$defs/Uuid" },
    "notes": { "type": ["string", "null"] }
  },
  "$defs": {
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "DatasetId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "ValidInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_precision"],
      "properties": {
        "valid_from": {
          "type": ["string", "null"],
          "format": "date"
        },
        "valid_to": {
          "type": ["string", "null"],
          "format": "date",
          "description": "Null means open-ended, not unknown."
        },
        "not_earlier_than": {
          "type": ["string", "null"],
          "format": "date"
        },
        "not_later_than": {
          "type": ["string", "null"],
          "format": "date"
        },
        "date_precision": {
          "type": "string",
          "enum": ["day", "month", "year", "bounded", "unknown"]
        },
        "basis": {
          "type": ["string", "null"],
          "enum": ["source_statement", "source_observation", "reviewer_inference", "system_recorded", null]
        },
        "note": { "type": ["string", "null"] }
      }
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref_type"],
      "properties": {
        "source_ref_type": {
          "type": "string",
          "enum": ["source_dataset", "source_record", "evidence_row", "site_observation", "contributor_attestation", "review_note"]
        },
        "source_dataset_id": { "$ref": "#/$defs/DatasetId" },
        "source_record_id": { "type": ["string", "null"] },
        "evidence_row_id": { "type": ["string", "null"] },
        "site_observation_id": { "type": ["string", "null"] },
        "url_or_file": { "type": ["string", "null"] },
        "licence_status": {
          "type": ["string", "null"],
          "enum": ["accepted", "needs_review", "restricted", "unknown", null]
        },
        "evidence_summary": { "type": ["string", "null"] }
      }
    }
  }
}
