{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-bayes.github.io/places-of-worship/schemas/indicator-observation.schema.json",
  "title": "Indicator Observation",
  "description": "A value for an indicator attached to an explicit spatial or temporal unit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "indicator_observation_id",
    "indicator_id",
    "unit_type",
    "unit_id",
    "time_period",
    "value",
    "quality_flag",
    "source_dataset_id"
  ],
  "properties": {
    "indicator_observation_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "indicator_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "unit_type": {
      "type": "string",
      "enum": ["site", "site_snapshot", "area_unit", "country", "grid_cell"]
    },
    "unit_id": {
      "type": "string"
    },
    "time_period": {
      "type": "string",
      "description": "A year, date, or explicit interval such as 2023 or 2023-03-07/2023-03-07."
    },
    "value": {
      "type": ["number", "integer", "null"]
    },
    "denominator": {
      "type": ["number", "integer", "null"]
    },
    "quality_flag": {
      "type": "string"
    },
    "suppression_flag": {
      "type": ["string", "null"]
    },
    "source_dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "notes": {
      "type": ["string", "null"]
    }
  }
}
