// wrangler config for the domain-redirect worker. custom domains create
// and own their DNS records; adding a hostname here and redeploying is
// the whole procedure for pointing another domain at the canonical site.
{
  "name": "domain-redirect",
  "main": "index.js",
  // deploys ride the wrangler OAuth login, not the DNS-scoped api token:
  // run  env -u CLOUDFLARE_API_TOKEN wrangler deploy
  "account_id": "4799a35f17f38fd6509d945820cc7075",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "powmap.org", "custom_domain": true },
    { "pattern": "www.powmap.org", "custom_domain": true }
  ]
}
